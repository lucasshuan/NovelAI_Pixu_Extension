{
    "manifest_version": 3,
    "name": "Pixu for NovelAI",
    "version": "0.2.0",
    "description": "Use your own story images on NovelAI, designed to work alongside an user script",
    "icons": {
        "16": "icons/icon.png",
        "48": "icons/icon.png",
        "128": "icons/icon.png"
    },
    "permissions": [
        "storage",
        "unlimitedStorage"
    ],
    "host_permissions": [
        "https://novelai.net/*"
    ],
    "web_accessible_resources": [
        {
        "resources": ["assets/*", "icons/*"],
        "matches": ["https://novelai.net/*"]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "https://novelai.net/*"
            ],
            "js": ["content.js"],
            "run_at": "document_start"
        }
    ]
}